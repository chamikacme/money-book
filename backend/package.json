{
  "name": "moneybook-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:production": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply moneybook-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply moneybook_db --remote",
    "db:seed:local": "wrangler d1 execute moneybook-db --local --file=seeds/dev.sql",
    "data:transform": "node scripts/transform-postgres-export.mjs"
  },
  "dependencies": {
    "@clerk/hono": "^0.1.98",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.47.0"
  }
}
